{
  "name": "cloakproxy",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "CloakProxy — Zero-Trust AI Dev Workbench (Chrome MV3 Side Panel + Firebase AI Logic hybrid inference)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" node scripts/build.mjs --watch",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" node scripts/build.mjs",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" vitest run",
    "test:watch": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" vitest",
    "e2e": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048\" playwright test",
    "boundaries": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "acorn": "^8.14.0",
    "firebase": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
